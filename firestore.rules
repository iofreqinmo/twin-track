rules_version = '2';

// Only the Google accounts listed below can read or change the log.
// Paste this into Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function isFamily() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'amgandolfo@gmail.com',
          'meganmc680@gmail.com'
        ];
    }

    match /events/{eventId} {
      allow read, write: if isFamily();
    }

    match /config/{docId} {
      allow read, write: if isFamily();
    }
  }
}
