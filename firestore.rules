rules_version = '2';

// Only the Google accounts listed below can read or change the log.
// This file is a template: the real email list lives only in the Firebase console
// (Firestore Database → Rules), so the addresses aren't stored in the repo.
// Replace the placeholders there, not here, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function isFamily() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'parent.one@example.com',
          'parent.two@example.com'
        ];
    }

    match /events/{eventId} {
      allow read, write: if isFamily();
    }

    match /config/{docId} {
      allow read, write: if isFamily();
    }
  }
}
